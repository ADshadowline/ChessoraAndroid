<?xml version="1.0" encoding="utf-8"?>
<!-- Icona per la barra di stato (notifiche push FCM): il logo Chessora (la "C" con il
     quadrato al centro e i pixel a sinistra) come silhouette bianca su sfondo
     trasparente, per convenzione Android (il sistema la ricolora). Usata da
     AndroidManifest.xml (meta-data "default_notification_icon") e da
     ChessoraFirebaseMessagingService. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- "C": arco aperto a destra -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="3"
        android:strokeLineCap="butt"
        android:fillColor="#00000000"
        android:pathData="M18.2,7.6A6.6,6.6 0,1 0,18.2 16.4" />
    <!-- Quadrato al centro -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M11.6,10.3h3.4v3.4h-3.4z" />
    <!-- Pixel a sinistra -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M4.6,8.2h1.5v1.5h-1.5z M2.6,10.6h1.5v1.5h-1.5z M4.6,12.9h1.5v1.5h-1.5z" />
</vector>
