<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifest dell'app. Permessi richiesti, minimi:
    - INTERNET: ogni schermata legge dati dall'Api Chessora.
    - POST_NOTIFICATIONS: richiesto da Android 13 (API 33+) per mostrare le
      notifiche push in foreground/background - va richiesto a runtime (vedi
      MainActivity.kt), qui è solo la dichiarazione.
    Nessun permesso relativo al numero di telefono: il login (ui/auth/) usa solo
    Google/ID FIDE/email+password, mai il numero della SIM.
    - VIBRATE: la schermata a tutto schermo di "turno pubblicato" (vedi
      ui/pairings/RoundPublishedOverlay.kt) fa vibrare il telefono 5 secondi -
      permesso "normale", nessuna richiesta a runtime necessaria.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".ChessoraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chessora">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Chessora">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Servizio FCM: riceve i messaggi push e i refresh del token (vedi
             push/ChessoraFirebaseMessagingService.kt). Dichiarato con priorità
             di default: il sistema lo avvia anche ad app chiusa. -->
        <service
            android:name=".push.ChessoraFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Canale di notifica di default e colore icona, letti da FCM quando il
             messaggio non specifica esplicitamente un canale (vedi anche
             ChessoraFirebaseMessagingService.ensureNotificationChannel). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

    </application>

</manifest>
